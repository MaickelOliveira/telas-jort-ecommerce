# Copie somente para desenvolvimento. Na VPS, execute: pnpm setup
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@exemplo.com.br
# Opção simples para EasyPanel. Use uma senha forte com pelo menos 12 caracteres.
# ADMIN_PASSWORD=troque-por-uma-senha-forte
# Opção recomendada para VPS: hash gerado por `pnpm admin:create -- email@dominio.com.br`.
ADMIN_PASSWORD_HASH=scrypt:COLOQUE_O_SALT:COLOQUE_O_HASH
# Recomendado. Se omitido no EasyPanel, é derivado da credencial administrativa.
SESSION_SECRET=gere-um-segredo-longo-e-aleatorio
CUSTOMER_SESSION_SECRET=gere-outro-segredo-longo-e-aleatorio
DATA_ENCRYPTION_KEY=base64-com-exatos-32-bytes
ANALYTICS_SALT=gere-outro-segredo-longo
SHIPPING_QUOTE_SECRET=gere-outro-segredo-longo
DATABASE_PATH=./data/telas-jort.sqlite

# Supabase/PostgreSQL: também podem ser preparados e testados no painel Integrações → Banco.
# A migração precisa ser concluída antes de remover DATABASE_PATH.
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST:5432/postgres

# Focus NFe: também pode ser configurada pelo painel Integrações → Fiscal.
# Comece sempre em sandbox e valide a tributação de cada produto com o contador.
# FOCUS_NFE_MODE=sandbox
# FOCUS_NFE_TOKEN=
# FOCUS_NFE_WEBHOOK_SECRET=
# FOCUS_NFE_ISSUER_CNPJ=
# FOCUS_NFE_ISSUER_STATE=PR
# FOCUS_NFE_TAX_REGIME=1
# FOCUS_NFE_NATURE_OPERATION=Venda de mercadoria
# FOCUS_NFE_FREIGHT_MODE=0

# Somente para visualizar o painel local sem senha. Nunca use em produção.
ALLOW_DEMO_ADMIN=false

# Marketplaces: prefira cadastrar pelo painel. Variáveis abaixo são opcionais.
# MERCADO_LIVRE_APP_ID=
# MERCADO_LIVRE_CLIENT_SECRET=
# MERCADO_LIVRE_ACCESS_TOKEN=
# MERCADO_LIVRE_REFRESH_TOKEN=
# MERCADO_LIVRE_USER_ID=
# SHOPEE_PARTNER_ID=
# SHOPEE_SHOP_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_ACCESS_TOKEN=
# SHOPEE_REFRESH_TOKEN=
